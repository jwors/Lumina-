<?xml version="1.0" encoding="utf-8"?>
<!-- Z·Lumina 标识：L 的金色竖 + 底边做框，Z 的顶边与斜杠踩在同一条底边上。
     108dp 自适应图标视口，内容收在安全圆内（约 32..78）。 -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <!-- L：竖 -->
    <path
        android:pathData="M32,30 L32,76"
        android:strokeColor="#C9A24B"
        android:strokeWidth="7"
        android:strokeLineCap="round"
        android:fillColor="#00000000"/>
    <!-- L：底边（同时是 Z 的底边） -->
    <path
        android:pathData="M32,76 L78,76"
        android:strokeColor="#C9A24B"
        android:strokeWidth="7"
        android:strokeLineCap="round"
        android:fillColor="#00000000"/>
    <!-- Z：顶边 -->
    <path
        android:pathData="M44,34 L76,34"
        android:strokeColor="#E4C77E"
        android:strokeWidth="4.6"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:fillColor="#00000000"/>
    <!-- Z：斜杠 -->
    <path
        android:pathData="M76,34 L44,70"
        android:strokeColor="#E4C77E"
        android:strokeWidth="4.6"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:fillColor="#00000000"/>
</vector>
